# Where build.sh sends the finished tileset:
#   local      -> copy into the goodways-api repo's custom_files (for local Sail)
#   production -> scp to the remote server below, then restart Valhalla
DESTINATION=local

# Local copy target (used when DESTINATION=local). Relative to the valhalla/ dir.
LOCAL_DEST=../../goodways-api/custom_files

# Deployment SSH user
VALHALLA_REMOTE_USER=deploy

# Deployment IP address or hostname 
VALHALLA_REMOTE_HOST=

# Absolute path on the server that the container mounts as /custom_files.
# If the server uses a Docker *named* volume (e.g. under Coolify), this must be
# the volume's `_data` subdirectory.
VALHALLA_REMOTE_PATH=/var/lib/docker/volumes/<stack>_valhalla-data/_data

# Space-separated URLs to .osm.pbf files.
# Only needed on first boot before tiles are built locally and uploaded.
# Once use_tiles_ignore_pbf=True is set, this is ignored.
VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/great-britain-latest.osm.pbf