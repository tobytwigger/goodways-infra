SERVICE_USER_WORDPRESS=
SERVICE_PASSWORD_WORDPRESS=
SERVICE_PASSWORD_ROOT=
# WORDPRESS_BREVO_WEBHOOK_SECRET=
SERVICE_URL_WORDPRESS=http://goodways.local
SERVICE_FQDN_WORDPRESS=goodways.local

# Host port mapped to the wordpress container's :80 (8080 is taken by matomo)
WORDPRESS_PORT=8081

WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_USER=$SERVICE_USER_WORDPRESS
WORDPRESS_DB_PASSWORD=$SERVICE_PASSWORD_WORDPRESS
WORDPRESS_DB_NAME=wordpress
MYSQL_ROOT_PASSWORD=$SERVICE_PASSWORD_ROOT
MYSQL_DATABASE=wordpress
MYSQL_USER=$SERVICE_USER_WORDPRESS
MYSQL_PASSWORD=$SERVICE_PASSWORD_WORDPRESS



WORDPRESS_DEBUG=true
