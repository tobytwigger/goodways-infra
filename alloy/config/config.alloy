// ============================================================
// DOCKER CONTAINER DISCOVERY
//
// Alloy needs to know which containers are running before it
// can collect logs from them. These two blocks handle that.
// ============================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  // Connect to Docker via the Unix socket (mounted in docker-compose.yml).
  // This gives Alloy a live list of all running containers and their
  // metadata (names, labels, image names, etc.).
}

discovery.relabel "containers" {
  // Takes the raw container list from discovery.docker and shapes the
  // labels that will be attached to every log line from each container.
  // Think of labels as indexed tags you can filter by in Grafana.
  targets = discovery.relabel.containers.targets

  // Rule 1: If the container has an app.name Docker label (which we set
  // on our services in their docker-compose.yml files), use that as the
  // "app" label. This gives clean names like "redis" or "laravel" rather
  // than Docker's auto-generated container names.
  rule {
    source_labels = ["__meta_docker_container_label_app_name"]
    target_label  = "app"
  }

  // Rule 2: Fall back to the container name if app.name wasn't set.
  // Docker container names have a leading slash (e.g. "/redis") so the
  // regex strips it. This rule only fires when app="" after rule 1.
  rule {
    source_labels = ["app", "__meta_docker_container_name"]
    separator     = ";"
    regex         = "^;/(.*)"
    target_label  = "app"
    replacement   = "$1"
  }

  // Rules 3 & 4: Carry through Docker Compose metadata as labels.
  // compose_project = the name of the compose stack (e.g. "redis")
  // compose_service = the service name within that stack (e.g. "redis-exporter")
  // Useful for filtering in Grafana when multiple services share a project.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}


// ============================================================
// LOGS → LOKI
//
// Reads log output from every running container and ships it
// to Loki for storage and querying in Grafana.
// ============================================================

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  // Uses the labelled container list produced above — one log stream
  // per container, with the labels we shaped in discovery.relabel.
  forward_to = [loki.process.enrich.receiver]
  // Don't write to Loki directly — pass through the processing
  // pipeline below first.
}

loki.process "enrich" {
  // A pipeline of stages applied to every log line in sequence.
  // Each stage can parse, transform, filter or label the line
  // before it's forwarded to the next stage or written to Loki.

  stage.docker {}
  // REQUIRED when using loki.source.docker.
  // Docker wraps every log line in a JSON envelope:
  //   {"log":"actual message","stream":"stdout","time":"2026-..."}
  // This stage unwraps it, extracts the real log content, sets the
  // timestamp from Docker's "time" field, and adds a "stream" label
  // (stdout vs stderr). Without it, the raw JSON wrapper gets stored
  // instead of the actual message.

  stage.static_labels {
    values = {
      server = sys.env("ALLOY_SERVER_NAME"),
      // sys.env() reads from the container's environment variables.
      // ALLOY_SERVER_NAME is set in Coolify's env vars UI and passed
      // through docker-compose.yml. Identifies which server these logs
      // came from — important if you ever run multiple servers.
      env = sys.env("ALLOY_ENV"),
      // e.g. "production". Useful if you add a staging server later.
    }
  }

  stage.json {
    // Attempt to parse the log line as JSON and extract specific fields
    // into the pipeline so later stages can use them.
    // Laravel (JSON log channel) and Nuxt (pino/consola) both emit
    // structured JSON. Lines that aren't JSON pass through unchanged —
    // they're still stored, just without these extracted fields.
    expressions = {
      level   = "level",   // e.g. "info", "warning", "error", "debug"
      traceId = "traceId", // injected by OpenTelemetry if you instrument your apps
    }
  }

  stage.labels {
    values = {
      level = "",
      // Promotes the "level" field extracted above into an indexed Loki
      // label, so you can filter logs by severity in Grafana.
      // Empty string means "use the value already extracted by stage.json".
      //
      // ⚠️  traceId is intentionally NOT a label. It has a unique value
      // per request (high cardinality), which would create a new Loki
      // stream per request and severely hurt query performance.
      // traceId stays as log line content — Grafana's derived fields
      // feature can still use it to jump from a log line to the
      // corresponding trace in Tempo.
    }
  }

  stage.drop {
    expression = ".*GET /health.*"
    // Discard health check log lines — they fire every few seconds and
    // have no diagnostic value. Keeps Loki storage lean.
  }
  stage.drop {
    expression = ".*GET /up.*"
    // Laravel 11's default /up health endpoint. Same reasoning as above.
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://localhost:3100/loki/api/v1/push"
    // Alloy runs with host networking, so "localhost" here refers to the
    // Docker host. Loki's port 3100 is bound to 127.0.0.1 on the host
    // in logging/docker-compose.yml, making it reachable this way.
  }
}


// ============================================================
// TRACES → TEMPO
//
// Your applications (Laravel, Nuxt) can send OpenTelemetry traces
// to Alloy. Alloy batches them up and forwards to Tempo for
// storage. Traces let you follow a single request across services.
// ============================================================

otelcol.receiver.otlp "default" {
  // Listens for incoming traces from your apps using the OpenTelemetry
  // Protocol (OTLP). Apps can send via gRPC (faster) or HTTP.
  // Because Alloy uses host networking, these ports are open on the
  // host itself — apps send to localhost:4317 or localhost:4318.
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
    // Laravel's OpenTelemetry PHP SDK uses HTTP by default.
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  // Buffers spans and sends them to Tempo in batches rather than one
  // at a time. Reduces network overhead and Tempo ingestion load.
  timeout         = "5s"   // flush at least every 5 seconds
  send_batch_size = 1000   // or sooner if 1000 spans have accumulated

  output {
    traces = [otelcol.exporter.otlp.local_tempo.input]
  }
}

otelcol.exporter.otlp "local_tempo" {
  // Forwards batched traces to Tempo over gRPC.
  // Tempo's gRPC port (4317) is remapped to 14317 on the host in
  // logging/docker-compose.yml to avoid conflicting with Alloy's own
  // 4317 listener above (both would otherwise try to bind the same port).
  client {
    endpoint = "localhost:14317"
    tls {
      insecure = true
      // No TLS needed for local container-to-container traffic.
    }
  }
}


// ============================================================
// METRICS → PROMETHEUS
//
// Alloy scrapes Prometheus-format metrics from exporters running
// on this host and forwards them to Prometheus for storage.
// Grafana queries Prometheus to power dashboards and alerts.
// ============================================================

prometheus.scrape "redis" {
  // Scrapes the Redis exporter sidecar (oliver006/redis_exporter).
  // Exposes Redis memory, hit rates, connected clients, etc.
  // Recommended dashboard: https://grafana.com/grafana/dashboards/11835
  targets = [{
    __address__ = "localhost:9121",
    job         = "redis",
    server      = sys.env("ALLOY_SERVER_NAME"),
  }]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "postgres" {
  // Scrapes the Postgres exporter sidecar (prometheus-community/postgres_exporter).
  // Exposes query counts, table sizes, replication lag, lock counts, etc.
  // Recommended dashboard: https://grafana.com/grafana/dashboards/9628
  targets = [{
    __address__ = "localhost:9187",
    job         = "postgres",
    server      = sys.env("ALLOY_SERVER_NAME"),
  }]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "node" {
  // Scrapes node_exporter for host-level metrics: CPU, memory, disk I/O,
  // network throughput, filesystem usage. Runs with host networking and
  // pid:host in docker-compose.yml so it can read /proc and /sys accurately.
  // Recommended dashboard: https://grafana.com/grafana/dashboards/1860
  targets = [{ __address__ = "localhost:9100", job = "node", server = sys.env("ALLOY_SERVER_NAME") }]
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.scrape "alloy_self" {
  // Scrapes Alloy's own internal metrics — log lines processed, errors,
  // pipeline throughput, memory usage. Lets you verify Alloy is healthy
  // and not silently dropping logs or traces.
  // Port 12345 is Alloy's built-in HTTP server (also hosts its debug UI).
  targets = [{
    __address__ = "localhost:12345",
    job         = "alloy",
    server      = sys.env("ALLOY_SERVER_NAME"),
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.local.receiver]
}

prometheus.remote_write "local" {
  // All scrape jobs above forward to this single remote_write block,
  // which pushes metrics to the local Prometheus instance.
  // --web.enable-remote-write-receiver must be set on Prometheus —
  // this is already done in logging/docker-compose.yml.
  endpoint {
    url = "http://localhost:9090/api/v1/write"
    // Alloy uses host networking; Prometheus is bound to 127.0.0.1:9090
    // on the host in logging/docker-compose.yml.
  }
}