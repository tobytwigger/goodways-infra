# Human-readable name for this specific server.
ALLOY_SERVER_NAME=api-server

# Environment label applied to all telemetry from this server.
ALLOY_ENV=production

# Loki (logs)
LOKI_URL=https://logs-prod-eu-west-0.grafana.net
LOKI_USER=123456

# Tempo (traces)
TEMPO_URL=tempo-eu-west-0.grafana.net:443
TEMPO_USER=234567

# Prometheus/Mimir (metrics)
PROM_URL=https://prometheus-prod-eu-west-0.grafana.net
PROM_USER=345678

# Shared API key for all three services
GRAFANA_CLOUD_API_KEY=glc_eyJ...