# Human-readable name for this specific server.
ALLOY_SERVER_NAME=api-server

# Environment label applied to all telemetry from this server.
ALLOY_ENV=production

# Loki (logs)
LOKI_URL=https://loki.goodways.org

# Tempo (traces)
# OTLP HTTP endpoint — full URL with https scheme
TEMPO_URL=https://tempo.goodways.org

# Prometheus/Mimir (metrics)
PROM_URL=https://prometheus.goodways.org
